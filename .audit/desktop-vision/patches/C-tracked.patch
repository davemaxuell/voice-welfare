+    def _check_app(self, candidate: dict, ctx: PolicyContext) -> dict:
+        """브라우저 밖 앱 동작. 웹 갈래와 같은 차례: 형식 → 멈춤 → 횟수 → 앱 허용 정도 → 동작 → 파일 종류 → 승인."""
+        action = parse_app_action(candidate)
+        if action is None:
+            return deny("DENIED_SCHEMA", "액션 형식이 계약과 맞지 않습니다.")
+        if ctx.stopped:
+            return deny("DENIED_STOPPED", "사용자가 중단을 요청했습니다.")
+        if ctx.actionsThisTurn >= self.config.maxActionsPerTurn:
+            return deny("DENIED_RATE_LIMIT", "한 번의 요청에서 허용된 조작 횟수를 넘었습니다.")
+
+        # 은행·인증서처럼 다루지 않기로 한 앱은 설정으로도 열리지 않는다. 설정은 허용을 좁히기만 한다.
+        app = APP_BY_ID[action.app]
+        spec = next((a for a in self.config.apps if a.id == action.app), None)
+        if app.tier == "never":
+            return deny("DENIED_APP", f"{josa(app.label, '은', '는')} 안전을 위해 제가 다루지 않아요.")
+        if spec is None or spec.tier != "control":
+            return deny("DENIED_APP", f"{josa(app.label, '은', '는')} 아직 열 수 없어요.")
+        if action.type not in spec.verbs:
+            return deny("DENIED_ACTION_TYPE", f"허용되지 않은 액션 유형({action.type})입니다.")
+
+        unknown_kind = False
+        if action.type == "open_file":
+            name = action.names[-1]
+            kind = FILE_KINDS.get(extension(name))
+            if kind in EXECUTABLE_KINDS:
+                quoted = f"'{name}'"
+                return deny("DENIED_EXECUTABLE", f"{josa(quoted, '은', '는')} 프로그램 파일이라 말로 실행하지 않아요.")
+            unknown_kind = kind not in OPENABLE_KINDS
+
+        # 위험도는 부르는 쪽이 높일 수만 있다: 모르는 종류의 파일은 낮게 적어 와도 승인을 받는다.
+        if action.risk != "low" or action.requiresConfirmation or unknown_kind:
+            if action.id in ctx.approvals:
+                return decision(True, "APPROVED", "사용자가 실행 전에 승인했습니다.")
+            return deny("NEEDS_CONFIRMATION", "실행 전에 사용자 승인이 필요합니다.")
+        return decision(True, "ALLOWED", "허용된 저위험 조작입니다.")
+
     def _risky_button(self, target: dict) -> bool:
