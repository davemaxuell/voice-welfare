{
  "name": "cheongeum",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "regen-fixtures": "uv run python scripts/regex_trace.py && uv run python scripts/oracle_trace.py && uv run python scripts/record_transcripts.py",
    "port-drift": "node scripts/port-drift.ts",
    "test-parity": "node scripts/test-parity.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "start": "uv run cheongeum-server",
    "eval": "uv run python scripts/run_scenarios.py"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.15.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  }
}
