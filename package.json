{
  "name": "cheongeum",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "port-drift": "node scripts/port-drift.ts",
    "port-ledger": "node scripts/port-ledger.ts",
    "test-parity": "node scripts/test-parity.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "ux-baseline": "npm run build:web && node scripts/ux-baseline.ts",
    "ux-screens": "node scripts/ux-screens.ts",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "eval": "node scripts/run-scenarios.ts",
    "prestart": "npm run build:web",
    "eval-agent": "node scripts/eval-agent.ts",
    "eval-stt": "node scripts/eval-stt.ts",
    "check-llm": "node scripts/check-llm.ts",
    "check-voice": "node scripts/check-voice.ts",
    "check-welfare": "node scripts/check-welfare.ts",
    "setup-models": "node scripts/setup-models.ts",
    "mock": "node scripts/mock-site.ts",
    "preeval": "npm run build:web",
    "start:desktop": "npm run build:web && node apps/desktop/scripts/build.ts app && electron apps/desktop/out/app",
    "build:desktop": "npm run build:web && node apps/desktop/scripts/build.ts dir",
    "dist:desktop": "npm run build:web && node apps/desktop/scripts/build.ts dist",
    "test:desktop": "node --test apps/desktop/test/updates.test.ts",
    "test:desktop-packaged": "node apps/desktop/test/packaged.ts",
    "test:desktop-release": "node apps/desktop/test/release.cjs",
    "test:desktop-installed": "node apps/desktop/test/installed.cjs",
    "test:desktop-avatar": "npm run build:web && node apps/desktop/scripts/build.ts app && node apps/desktop/test/avatar.e2e.cjs",
    "test:desktop-native": "npm run build:web && node apps/desktop/scripts/build.ts app && node apps/desktop/test/native-a11y.cjs",
    "dev:desktop": "npm run start:desktop",
    "dist:win": "npm run dist:desktop"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.170.0",
    "@types/ws": "8.18.2",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "@huggingface/tokenizers": "0.2.0",
    "@napi-rs/keyring": "2.1.2",
    "electron-updater": "6.8.11",
    "entities": "9.0.0",
    "fast-xml-parser": "5.12.1",
    "fflate": "0.8.3",
    "hono": "4.13.19",
    "playwright": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.170.0",
    "unpdf": "2.2.1",
    "ws": "8.23.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.31.1",
    "pg": "8.23.1"
  }
}
