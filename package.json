{
  "name": "cheongeum",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "regen-fixtures": "uv run python scripts/regex_trace.py && uv run python scripts/oracle_trace.py && uv run python scripts/record_transcripts.py",
    "port-drift": "node scripts/port-drift.ts",
    "test-parity": "node scripts/test-parity.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "eval": "node scripts/run-scenarios.ts",
    "record:observations": "uv run python scripts/record_observations.py",
    "eval-agent": "node scripts/eval-agent.ts",
    "eval-stt": "node scripts/eval-stt.ts",
    "check-llm": "node scripts/check-llm.ts",
    "check-voice": "node scripts/check-voice.ts",
    "check-welfare": "node scripts/check-welfare.ts",
    "setup-models": "node scripts/setup-models.ts",
    "mock": "node scripts/mock-site.ts"
  },
  "devDependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "@napi-rs/keyring": "2.1.2",
    "entities": "9.0.0",
    "fast-xml-parser": "5.12.1",
    "fflate": "0.8.3",
    "hono": "4.13.19",
    "playwright": "1.65.1",
    "unpdf": "2.2.1",
    "zod": "^4.6.7"
  }
}
